<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PlcWiringTrainer.App</RootNamespace>
    <AssemblyName>PlcWiringTrainer</AssemblyName>
    <Version>4.1.2</Version>
    <AssemblyVersion>4.1.2.0</AssemblyVersion>
    <FileVersion>4.1.2.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Devices\**\*"
             Exclude="Assets\Devices\Legacy\manual\xbc-dn32h-ppt-open-front-transparent.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <!-- WinUI declares the browser SDK transitively. Excluding every asset prevents its
         projection and loader from entering this native-only app or publish output. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77"
                      ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlcWiringTrainer.Core\PlcWiringTrainer.Core.csproj" />
  </ItemGroup>

  <!-- WinUI ships an unused packaging staging tree and a control-map HTML file.
       The app has no package identity or embedded browser surface, so neither belongs in the product output. -->
  <Target Name="RemoveNonRuntimeWinUiBuildArtifacts" AfterTargets="Build"
          Condition="'$(TargetDir)' != '' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <ItemGroup>
      <_UnusedAppxStaging Include="$(TargetDir)AppX\**\*" />
    </ItemGroup>
    <Delete Files="@(_UnusedAppxStaging)" />
    <RemoveDir Directories="$(TargetDir)AppX" />
    <Delete Files="$(TargetDir)Microsoft.UI.Xaml\Assets\map.html" />
  </Target>

  <Target Name="FinalizeNativeWinUiPublishOutput" AfterTargets="Publish"
          Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)$(AssemblyName).exe')">
    <ItemGroup>
      <_NativeXamlPublishArtifacts Include="$(TargetDir)**\*.xbf" />
      <_NativeXamlPublishArtifacts Include="$(TargetDir)$(AssemblyName).pri" />
      <_UnusedPublishedHtmlArtifact Include="$(PublishDir)Microsoft.UI.Xaml\Assets\map.html" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeXamlPublishArtifacts)"
          DestinationFiles="@(_NativeXamlPublishArtifacts->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Delete Files="@(_UnusedPublishedHtmlArtifact)" />
  </Target>
</Project>
