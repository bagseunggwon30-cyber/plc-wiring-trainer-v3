<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PlcWiringTrainer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PlcWiringTrainer.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PLC Wiring Trainer 4.3.0"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="PLC Wiring Trainer 4.3.0">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- WorkbenchShell은 문서 세션과 Page 수명 주기를 공유합니다. -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
