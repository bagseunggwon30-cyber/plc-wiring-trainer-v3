{
  "name": "wiring-trainer",
  "version": "2.2.0",
  "description": "박승권의 결선 작업장 - PLC/HMI/인버터 결선 연습 데스크톱 앱",
  "main": "main.js",
  "scripts": {
    "test": "npm run test:legacy && npm run test:unit",
    "test:legacy": "node --test tests/*.test.js",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:renderer": "vite build",
    "verify": "npm run test && npm run typecheck && npm run build:renderer",
    "start": "npm run build:renderer && electron .",
    "test:e2e": "playwright test",
    "test:performance": "vitest run tests/unit/performance-release-gate.test.ts",
    "verify:release": "npm run verify && npm run test:e2e",
    "build": "npm run verify:release && electron-builder --win portable --x64",
    "build:installer": "npm run verify:release && electron-builder --win nsis --x64"
  },
  "author": "bark",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@types/rbush": "4.0.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.bark.wiring-trainer",
    "productName": "결선 작업장",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "build/renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "결선작업장-${version}-portable.exe"
    }
  },
  "dependencies": {
    "rbush": "4.0.1",
    "zod": "4.4.3"
  }
}
